# 复制成 .env 后填值（.env 已在 .gitignore 里，不要提交）。
# 这些值只给 docker compose 用；直接 `npm start` 时请改用 shell 环境变量。

# 生成快照密钥：openssl rand -hex 32
POKER_STORAGE_KEY=

# 数据库口令：请另起一个随机值，不要和上面的密钥相同。
# 注意：这个口令会被拼进 POKER_PG_URL，请只用字母数字（或自己做百分号编码），
# 否则 @ : / ? 这些字符会被当成 URL 结构而不是口令内容。
POSTGRES_PASSWORD=

# production：禁用游客登录，必须配置微信凭据才能登录（未配置则无人能登录）。
# development：游客登录可用，适合本地试跑，切勿对公网开放。
POKER_MODE=production

# 微信小程序凭据（微信公众平台 → 开发管理 → 开发设置）。
# 留空时 /api/auth/wechat 返回 501（开发模式）或 503（生产模式），并给出中文提示。
POKER_WECHAT_APPID=
POKER_WECHAT_SECRET=

# WebSocket 的 Origin 白名单，逗号分隔，例如 https://poker.example.com。
# 留空 = 不校验（任何网页都能发起连接）；小程序不带 Origin 头，任何情况下都不受影响。
# 它只是纵深防御：真正的门槛是 subscribe 里的令牌与成员身份校验。
POKER_ALLOWED_ORIGINS=

.code {
  font-size: 56rpx;
  letter-spacing: 10rpx;
  color: #B5A642;
  text-align: center;
  padding: 20rpx 0;
}

.link-text {
  font-size: 24rpx;
  color: rgba(245, 239, 220, 0.62);
}

.member {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid rgba(181, 166, 66, 0.18);
}

.member:last-child {
  border-bottom: none;
}

.member-name {
  font-size: 28rpx;
}

.member-name .tag {
  margin-left: 10rpx;
}

.member-right {
  text-align: right;
  font-size: 24rpx;
}

.remove {
  display: block;
  margin-top: 8rpx;
  color: #E4786C;
}

.code {
  font-size: 56rpx;
  letter-spacing: 10rpx;
  color: var(--accent);
  text-align: center;
  padding: 20rpx 0;
}

.link-text {
  font-size: 24rpx;
  color: var(--muted);
}

.member {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.member:last-child {
  border-bottom: none;
}

.member-name {
  font-size: 28rpx;
}

.member-name .tag {
  margin-left: 10rpx;
}

.member-right {
  text-align: right;
  font-size: 24rpx;
}

.remove {
  display: block;
  margin-top: 8rpx;
  color: var(--danger);
}

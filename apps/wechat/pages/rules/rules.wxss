.rules {
  padding-bottom: 60rpx;
}

.rule-item {
  position: relative;
  padding-left: 26rpx;
  margin-bottom: 10rpx;
  font-size: 26rpx;
  color: rgba(245, 239, 220, 0.9);
}

.rule-item::before {
  content: '·';
  position: absolute;
  left: 8rpx;
  color: #B5A642;
}

.rank-row {
  display: flex;
  align-items: baseline;
  padding: 8rpx 0;
  border-bottom: 1rpx solid rgba(181, 166, 66, 0.14);
}

.rank-name {
  width: 160rpx;
  color: #B5A642;
  font-size: 26rpx;
}

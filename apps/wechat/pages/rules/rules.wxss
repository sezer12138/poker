.rules {
  padding-bottom: 60rpx;
}

.rule-item {
  position: relative;
  padding-left: 26rpx;
  margin-bottom: 10rpx;
  font-size: 26rpx;
  color: var(--ink);
}

.rule-item::before {
  content: '·';
  position: absolute;
  left: 8rpx;
  color: var(--accent);
}

.rank-row {
  display: flex;
  align-items: baseline;
  padding: 8rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.rank-name {
  width: 160rpx;
  color: var(--accent);
  font-size: 26rpx;
}

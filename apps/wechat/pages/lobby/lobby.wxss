.lobby {
  padding-bottom: 60rpx;
}

.brand {
  padding: 32rpx 8rpx 24rpx;
}

.brand-title {
  font-size: 44rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.brand-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--muted);
}

/* 首次进入的教程引导条：整条可点，点完记下已看过。 */
.guide {
  border-left-color: var(--accent);
}

.nick {
  margin-top: 16rpx;
}

.picker {
  padding: 8rpx 24rpx;
  border: 1rpx solid var(--line-strong);
  border-radius: 8rpx;
  color: var(--accent);
  font-size: 26rpx;
}

.invite {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed var(--line);
}

.ph {
  color: var(--muted);
}

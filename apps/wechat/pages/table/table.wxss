.table-page {
  min-height: 100vh;
  padding: 16rpx;
  box-sizing: border-box;
}

.topbar {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: var(--muted);
  padding: 4rpx 8rpx 12rpx;
}

.topbar .link {
  color: var(--accent);
}

.felt {
  position: relative;
  height: 760rpx;
  margin: 8rpx 0 16rpx;
  border-radius: 50% / 42%;
  border: 2rpx solid var(--line-strong);
  background: var(--surface);
}

.center {
  position: absolute;
  left: 50%;
  top: 44%;
  transform: translate(-50%, -50%);
  text-align: center;
  width: 60%;
}

.pot-label {
  display: block;
  font-size: 22rpx;
  color: var(--muted);
}

.pot-value {
  display: block;
  font-size: 40rpx;
  color: var(--accent);
  font-weight: 600;
}

.board {
  display: flex;
  justify-content: center;
  margin-top: 12rpx;
}

.board-card {
  width: 62rpx;
  height: 88rpx;
  margin: 0 4rpx;
  border-radius: 8rpx;
  border: 1rpx solid var(--line);
  background: var(--surface);
  color: var(--ink);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
}

.board-card.red {
  color: var(--danger);
}

.board-card.empty {
  background: var(--surface-2);
  border: 1rpx dashed var(--line-strong);
}

.next-hand {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--accent);
}

.seat {
  position: absolute;
  width: 168rpx;
  margin-left: -84rpx;
  margin-top: -70rpx;
  padding: 8rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--line);
  background: var(--surface);
  text-align: center;
  box-sizing: border-box;
}

.seat.vacant {
  opacity: 0.28;
  border-style: dashed;
}

.seat.self {
  border-color: var(--accent);
  background: var(--accent-soft);
}

.seat.actor {
  box-shadow: 0 0 0 2rpx var(--accent);
}

.seat.folded {
  opacity: 0.42;
}

.seat-name {
  font-size: 22rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.seat-name .tag {
  margin-left: 6rpx;
  font-size: 18rpx;
}

.seat-cards {
  display: flex;
  justify-content: center;
  margin: 4rpx 0;
}

.mini-card {
  width: 40rpx;
  height: 56rpx;
  margin: 0 3rpx;
  border-radius: 5rpx;
  border: 1rpx solid var(--line);
  background: var(--surface);
  color: var(--ink);
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.mini-card.red {
  color: var(--danger);
}

.mini-card.back {
  background: repeating-linear-gradient(
    45deg,
    var(--surface-2),
    var(--surface-2) 6rpx,
    var(--line) 6rpx,
    var(--line) 12rpx
  );
}

.seat-stack {
  font-size: 20rpx;
  color: var(--accent);
  font-weight: 600;
}

.seat-bet {
  font-size: 18rpx;
  color: var(--muted);
}

.seat-award {
  font-size: 20rpx;
  color: var(--accent);
}

.seat-timer {
  font-size: 20rpx;
  color: var(--accent);
}

.seat-timer.urgent {
  color: var(--danger);
}

.pos {
  position: absolute;
  top: -14rpx;
  left: -8rpx;
  min-width: 34rpx;
  height: 34rpx;
  line-height: 34rpx;
  padding: 0 6rpx;
  border-radius: 999rpx;
  background: var(--surface-2);
  color: var(--ink);
  font-size: 18rpx;
  text-align: center;
}

.pos.sb,
.pos.bb {
  background: var(--brass);
  color: var(--on-accent);
}

.result,
.actions,
.waiting,
.events,
.finish,
.footer {
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

/* 正负金额：赢用品牌绿、输用危险红，与服务端 settle.changes 的符号一致。 */
.amount-win {
  color: var(--ok);
}

.amount-lose {
  color: var(--danger);
}

.amount-none {
  color: var(--muted);
}

.quick {
  display: flex;
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.quick-item {
  flex: 1 1 30%;
  min-width: 30%;
  margin: 6rpx;
  padding: 10rpx 0;
  border-radius: 10rpx;
  border: 1rpx solid var(--line-strong);
  text-align: center;
}

.quick-label {
  font-size: 24rpx;
  color: var(--accent);
}

.quick-add {
  font-size: 20rpx;
  color: var(--muted);
}

.raise-box {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
}

.raise-step {
  width: 72rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 10rpx;
  border: 1rpx solid var(--line-strong);
  color: var(--accent);
}

.raise-input {
  flex: 1;
  margin: 0 12rpx;
  height: 64rpx;
  padding: 0 16rpx;
  border-radius: 10rpx;
  border: 1rpx solid var(--line);
  background: var(--surface-2);
  color: var(--ink);
  text-align: center;
}

.raise-range {
  font-size: 20rpx;
  color: var(--muted);
}

.btns {
  display: flex;
  flex-wrap: wrap;
}

.btns .btn {
  flex: 1 1 40%;
  margin: 8rpx;
}

.waiting {
  text-align: center;
}

.event {
  font-size: 22rpx;
  color: var(--ink);
  padding: 6rpx 0;
  border-bottom: 1rpx solid var(--line);
}

/* 结算确认弹窗：铺满全屏，挡住牌桌，逼玩家先看一眼谁赢谁输。 */
.dialog-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(20, 24, 28, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
  z-index: 100;
}

.dialog {
  width: 100%;
  max-height: 80vh;
  overflow-y: auto;
  background: var(--surface);
  border-radius: 20rpx;
  padding: 32rpx;
  box-sizing: border-box;
}

.dialog-title {
  font-size: 34rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.dialog-subtitle {
  font-size: 24rpx;
  color: var(--muted);
  margin-bottom: 20rpx;
}

.dialog-row {
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--line);
}

/* 每个座位两行：上面输赢金额，下面亮出来的牌与剩余筹码。 */
.dialog-head {
  display: flex;
  align-items: baseline;
}

.dialog-name {
  flex: 1 1 auto;
  font-size: 26rpx;
}

.dialog-detail {
  font-size: 22rpx;
  color: var(--muted);
  margin-right: 16rpx;
}

.dialog-amount {
  font-size: 28rpx;
  font-weight: 600;
}

.dialog-info {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--muted);
}

.dialog-cards {
  display: flex;
  margin-right: 10rpx;
}

.dialog-type {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--ink);
  margin-right: 10rpx;
}

.dialog-stack {
  margin-left: auto;
}

.dialog-acks {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.dialog-timer {
  margin-top: 6rpx;
  color: var(--accent);
}

.dialog-note {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: var(--muted);
}

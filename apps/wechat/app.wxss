/* 简约主题：暖白底、白色卡片、墨色文字，只在品牌绿与庄家标记上用色。
   变量只在 page 上定义一次（与 web 端 apps/web/static/styles.css 同一套色值），
   页面样式只做局部覆盖；改配色只改这里。 */
page {
  --bg: #F5F4F0;
  --surface: #FFFFFF;
  --surface-2: #F0EEE9;
  --line: #E6E3DC;
  --line-strong: #D5D1C7;
  --ink: #22252A;
  --muted: #6E737B;
  --accent: #2F6A50;
  --accent-dark: #245741;
  --accent-soft: #EAF2EE;
  --on-accent: #FFFFFF;
  --brass: #A98A4E;
  --danger: #C0564F;
  --ok: #2F7A57;

  background: var(--bg);
  color: var(--ink);
  font-size: 28rpx;
  line-height: 1.5;
}

.page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 12rpx;
}

.btn {
  display: block;
  width: 100%;
  padding: 24rpx 0;
  margin-top: 16rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--line-strong);
  background: var(--surface-2);
  color: var(--ink);
  font-size: 30rpx;
  text-align: center;
  box-sizing: border-box;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: var(--accent);
  border-color: var(--accent);
  color: var(--on-accent);
  font-weight: 600;
}

.btn[disabled] {
  opacity: 0.45;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.muted {
  color: var(--muted);
  font-size: 24rpx;
}

.brass {
  color: var(--brass);
}

.danger {
  color: var(--danger);
}

.tag {
  display: inline-block;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--line-strong);
  color: var(--muted);
  font-size: 22rpx;
}

.input {
  background: var(--surface-2);
  border: 1rpx solid var(--line);
  border-radius: 12rpx;
  padding: 18rpx;
  color: var(--ink);
}

.notice {
  background: var(--accent-soft);
  border-left: 6rpx solid var(--accent);
  border-radius: 8rpx;
  padding: 16rpx;
  font-size: 24rpx;
  margin-bottom: 20rpx;
}

.error {
  color: var(--danger);
  font-size: 24rpx;
  margin-top: 12rpx;
}

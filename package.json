    "test:exhaustive": "node --test packages/poker-engine/test/exhaustive/*.test.ts",
    "typecheck": "tsc --noEmit",
    "demo": "node examples/simulate.ts",
    "smoke": "node examples/smoke.ts --spawn"
  },
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "pg": "8.13.1"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/pg": "8.11.10",
    "typescript": "7.0.2"
  }
}
